{
  "name": "lahjaty",
  "version": "0.1.0",
  "description": "Lahjaty - learn Arabic dialects (Arabs and foreigners)",
  "scripts": {
    "audio:index": "tsx scripts/build-audio-index.ts",
    "audio:missing": "tsx scripts/missing-audio.ts",
    "content:check": "tsx scripts/check-content.ts",
    "dict:build": "python3 scripts/dictionary/build.py",
    "predev": "npm run audio:index && npm run tts:manifest",
    "dev": "next dev",
    "prebuild": "npm run audio:index && npm run tts:manifest && npm run content:check",
    "build": "next build && npm run og && find out -name '__next*.txt' -delete && find out -name 'index.txt' -delete && rm -rf dist && cp -r out dist",
    "og": "tsx scripts/og/build.ts",
    "preview": "python3 -m http.server 4173 --directory out",
    "pretest": "npm run audio:index && npm run tts:manifest",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "tts:manifest": "tsx scripts/tts-manifest.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alhinawi/lahjaty-Learn-Arabic-Dialects.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/alhinawi/lahjaty-Learn-Arabic-Dialects/issues"
  },
  "homepage": "https://github.com/alhinawi/lahjaty-Learn-Arabic-Dialects#readme",
  "dependencies": {
    "@fontsource-variable/readex-pro": "^5.3.0",
    "@fontsource/el-messiri": "^5.3.0",
    "@fontsource/noto-naskh-arabic": "^5.3.0",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.1.0",
    "next": "^16.4.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "@tailwindcss/postcss": "^4.3.5"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
