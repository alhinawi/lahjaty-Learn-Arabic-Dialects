{
  "name": "lahjaty",
  "version": "0.1.0",
  "description": "Lahjaty - learn Arabic dialects (Arabs and foreigners)",
  "scripts": {
    "audio:index": "tsx scripts/build-audio-index.ts",
    "audio:missing": "tsx scripts/missing-audio.ts",
    "content:check": "tsx scripts/check-content.ts",
    "predev": "npm run audio:index",
    "dev": "vite",
    "prebuild": "npm run audio:index && npm run content:check",
    "build": "tsc -b && vite build && npm run og",
    "og": "tsx scripts/og/build.ts",
    "preview": "vite preview",
    "pretest": "npm run audio:index",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alhinawi/lahjaty-Learn-Arabic-Dialects.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/alhinawi/lahjaty-Learn-Arabic-Dialects/issues"
  },
  "homepage": "https://github.com/alhinawi/lahjaty-Learn-Arabic-Dialects#readme",
  "dependencies": {
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.7.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^6.4.6",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=20.11"
  }
}
